# What a kernel needs to boot under Firecracker on x86_64, for acrboot.
# Merge into a configuration with
#   scripts/kconfig/merge_config.sh -m .config acrboot.config && make olddefconfig
# (see firecracker/docs/kernel-policy.md).
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# ACPI device discovery; Firecracker needs CONFIG_PCI for it even without PCI devices
CONFIG_ACPI=y
CONFIG_PCI=y
# virtio over MMIO, and block devices for --disk
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# the serial console acrboot shows
CONFIG_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# reboot: Firecracker stops the VM when the kernel resets it through the i8042
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
# common root filesystems for --disk
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# acrboot --run mounts tmpfs over /tmp, /run, /root and the --dir path's top
CONFIG_TMPFS=y
