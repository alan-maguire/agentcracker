# agentcracker additions on top of firecracker's microvm-kernel-ci-x86_64-6.18.config
# Read-only layers (/usr, toolchains, project lower) are uncompressed EROFS
# images produced by agentcracker's own image writer.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# overlayfs: keep the upper layer simple to serialise (no redirects/metacopy)
CONFIG_OVERLAY_FS=y
# CONFIG_OVERLAY_FS_REDIRECT_DIR is not set
# CONFIG_OVERLAY_FS_METACOPY is not set
# CONFIG_OVERLAY_FS_INDEX is not set
# No modules, no initramfs: everything built in.
# CONFIG_MODULES is not set
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Nested containers (podman inside the guest)
CONFIG_CGROUPS=y
CONFIG_USER_NS=y
CONFIG_VETH=y
CONFIG_TUN=y
